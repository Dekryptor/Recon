<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>recon</AssemblyName>
    <RootNamespace>Recon.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Recon.Core/Recon.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The CLI is an executable, but its command surface is what the integration tests drive. -->
    <InternalsVisibleTo Include="Recon.Tests" />
  </ItemGroup>
</Project>
